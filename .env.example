APP_NAME="Tiny Knacks"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=miniapps
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Advertising (Google AdSense). When ADS_ENABLED=false, ad components render nothing.
ADS_ENABLED=false
ADS_CLIENT_ID=
ADS_SLOT_TOP=
ADS_SLOT_BOTTOM=
ADS_SLOT_SIDEBAR=

# Analytics (GA4 measurement ID, e.g. G-XXXXXXX). When ANALYTICS_ENABLED=false, nothing is rendered.
ANALYTICS_ENABLED=false
ANALYTICS_GA_ID=
ANALYTICS_GTM_ID=

# Optional Twitter/X handle without "@" for twitter:site
SITE_TWITTER=

# SEO / site identity
SITE_CONTACT_EMAIL=info@tinyknacks.com
# Comma-separated official profile URLs (Organization sameAs), e.g. https://x.com/tinyknacks
SITE_SAME_AS=
# Search Console / Bing Webmaster verification tokens (meta tag content only)
SITE_GOOGLE_VERIFICATION=
SITE_BING_VERIFICATION=
# In production, 301-redirect other hosts/schemes (www, http) to APP_URL
SITE_FORCE_CANONICAL_HOST=true
